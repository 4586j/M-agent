# Python
__pycache__/
*.py[cod]
*.egg-info/

# Web
web/node_modules/
web/dist/
web/.vite/

# 运行时产物（测试/运行生成）
.playwright-mcp/
workspace/agent/orchestrator/runtime/.tasks/
workspace/agent/orchestrator/runtime/audit/
worker/.worker_work/
_e2e/
.agent_usage/
# 经验库落盘产物（测试/运行散落到仓库根，正常应在 runtime/.experiences/）
/exp-local-*.json

# 本地密钥/配置（含 ANTHROPIC_API_KEY 等，切勿提交；用 .env.example 作模板）
.env
.env.local
.env.*.local

.orch_session
# 规划/进度产物
.orch_progress/
.agent_progress/
.agent_session
# IDE / 本地缓存
.idea/
.vite/

# 经验库运行时落盘（与 .tasks 同性质，属于运行时数据）
workspace/agent/orchestrator/runtime/.experiences/
workspace/agent/orchestrator/runtime/audit/

# 真实任务运行产物目录
result/
workspace/agent/orchestrator/runtime/.tasks-run/
workspace/agent/orchestrator/runtime/.exp-run/
workspace/agent/orchestrator/runtime/.sched-run/
workspace/agent/orchestrator/runtime/.proc-run/

# Agent 面板/服务运行时
.zcode/
workspace/agent/skills/orchestrator/memory/context/task-*/
result/.last_run_id

# agent 运行任务临时目录（run-<hash>）
.agent_work/

# skillhub 生成产物（install --with-mcp 的 mcp.json + 报告，生成物不入库）
workspace/agent/skillhub_runtime/

# brain provider 池（含 API 密钥；建议用 ${ENV} 引用避免明文）
workspace/agent/orchestrator/runtime/providers.json
workspace/agent/orchestrator/runtime/budgets.json
workspace/agent/orchestrator/runtime/.sessions/
workspace/agent/orchestrator/runtime/.knowledge/
.agent_policy.json
web/test-results/
web/playwright-report/
