# =============================================================================
# agent_core 配置模板
#
# 用法：
#   1) 复制本文件为项目根的 .env（.env 已被 .gitignore 忽略，不会提交）：
#        PowerShell:  Copy-Item .env.example .env
#        bash:        cp .env.example .env
#   2) 填入真实值，然后照常启动 `agent` 即可——启动时自动读取，无需每次 export。
#
# 规则：
#   - 已存在的真实环境变量优先级更高（本文件不覆盖），可在 shell 里临时覆盖。
#   - 换位置/换文件名：设 AGENT_ENV_FILE=/path/to/your.env 指定。
#   - 值可加引号也可不加；# 开头为注释；允许行首 export 前缀。
# =============================================================================

# ---- 大模型鉴权（必填，真正跑任务的前提）----
# 二选一，取决于你用的是官方端点还是第三方 Anthropic 兼容端点：
#
# (A) Anthropic 官方：只需 API Key
# ANTHROPIC_API_KEY=sk-ant-请替换为你的真实key
#
# (B) 第三方兼容端点（如阿里云百炼 Token Plan、自建网关）：用 AUTH_TOKEN + BASE_URL。
#     ⚠️ 此时不要用 ANTHROPIC_API_KEY——Claude Code 会把它当作冲突的官方凭证而拒绝启动。
#     端点/Key/模型名以服务商为准；Token Plan 的模型用「点号命名」（如 qwen3.7-plus），
#     连字符旧名（qwen3-coder-plus / qwen-max）会报 400 "Model not exist"。
# ANTHROPIC_AUTH_TOKEN=请替换为服务商给的Key
# ANTHROPIC_BASE_URL=https://你的兼容端点/apps/anthropic
# ANTHROPIC_MODEL=qwen3.7-plus
# ANTHROPIC_DEFAULT_HAIKU_MODEL=qwen3.8-flash
# ANTHROPIC_DEFAULT_SONNET_MODEL=qwen3.7-plus
# ANTHROPIC_DEFAULT_OPUS_MODEL=qwen3.7-max

# ---- 模型（可选）----
# 不设则用 SDK 默认；也可用命令行 --model 覆盖（命令行优先级最高）。
# AGENT_MODEL=sonnet

# ---- 执行控制（可选）----
# AGENT_MAX_TURNS=50
# AGENT_MAX_THINKING_TOKENS=10000
# AGENT_TASK_BUDGET_USD=0.5
# AGENT_TASK_TIMEOUT=900
# 权限模式默认 default（SDK 权限门控生效，工具调用需确认/受白名单约束）。
# bypassPermissions 会完全跳过权限门控，仅在开发/受控环境下显式设置：
# AGENT_PERMISSION_MODE=default

# ---- 人设 / 能力增强（可选）----
# AGENT_PERSONA=executor
# Plan-Execute 两阶段引擎（阶段四）：开启后 oneshot 先产出结构化计划再逐步骤执行，
# 步骤失败自动重试（最多 2 次），支持断点续跑（进度存 .orch_progress/）；
# 默认关闭，关闭时行为与单轮执行完全一致：
# AGENT_PLANNING_ENABLED=false
# AGENT_REFLECTION_ENABLED=false
# AGENT_RAG_ENABLED=false

# ---- 输出质量守卫（可选，默认开启）----
# 检出退化输出（无规则乱码/重复循环/无意义内容）后自动重试（默认 1 次，
# 在用户消息末尾追加纠偏提示，不动稳定前缀以保住 prompt caching）：
# 第 2 次重试换备用模型（AGENT_FALLBACK_MODEL，空=不换模型）；
# 重试前检查任务累计花费，达 task_budget_usd 的 80% 则停止重试（防预算放大）；
# 重试耗尽仍退化则熔断：任务按失败收场（error_type=degenerate_output），不谎报成功。
# AGENT_OUTPUT_GUARD_ENABLED=true
# AGENT_OUTPUT_GUARD_MAX_RETRIES=1
# AGENT_FALLBACK_MODEL=
# 集群 worker 同样读取本组配置：AGENT_ 前缀优先，ORCH_ 前缀兜底（例如
# ORCH_OUTPUT_GUARD_ENABLED / ORCH_OUTPUT_GUARD_MAX_RETRIES / ORCH_FALLBACK_MODEL）。

# ---- 记忆（可选，阶段四）----
# 核心记忆按相关性筛选 Top-K 注入而非全量（默认关闭＝全量注入，行为不变）：
# AGENT_MEMORY_CORE_RETRIEVAL=false
# 经验库 embedding 模型（sentence-transformers 模型名；不设则走默认加载逻辑，
# 加载失败自动降级为纯关键词检索，不影响功能）：
# AGENT_EMBEDDING_MODEL=

# ---- MCP 工具（可选）----
# 不设则自动发现项目根 .mcp.json
# AGENT_MCP_CONFIG=.mcp.json
#
# MCP env 传递鉴权配置示例：mcpServers 的 env 字段用于给 MCP 子进程
# 传递鉴权/密钥，MCP 工具（如 GitHub/数据库服务端）据此完成自身鉴权。
# .mcp.json 示例：
# {
#   "mcpServers": {
#     "github": {
#       "command": "npx",
#       "args": ["-y", "@modelcontextprotocol/server-github"],
#       "env": { "GITHUB_TOKEN": "<your-token>" }
#     }
#   }
# }
# ⚠️ 安全约定（阶段一）：.mcp.json 可能随仓库分发，请勿把真实密钥提交进去——
#    密钥放在本 .env（真实环境变量）或启动脚本中 export，再由启动器
#    合入 mcpServers 的 env；子进程仅继承所需的最小鉴权变量。

# ---- HTTP 服务 / 远程 brain 鉴权（可选，单机默认用不到）----
# ⚠️ AGENT_API_KEY 用于本地 HTTP 服务的 X-API-Key 校验、以及调用远程 brain，
#    不是大模型 Key。
# AGENT_API_KEY=
# AGENT_MEMORY_BACKEND=local
# AGENT_BRAIN_URL=http://127.0.0.1:7000

# ---- 编排运行时安全加固（阶段一，可选）----
# 未设置 ORCH_API_KEY 时，brain/worker 默认仅放行环回地址（127.0.0.1/::1），
# 非环回请求拒绝（403）；跨主机部署务必设置 key，或显式恢复全开放（仅限受控环境）：
# ORCH_ALLOW_UNAUTHENTICATED=1
# 安全裁决审计日志落盘路径（默认 runtime/audit/security_audit.jsonl）：
# ORCH_AUDIT_LOG=
# security-guard LLM 增强默认开启，需要时显式关闭：
# ORCH_SECURITY_LLM=1

# Brain 每次执行的预算预占估值（美元，默认 0.05，必须大于 0）：
# 剩余额度小于预占值时拒绝派发；实际费用回传后结算并释放差额。
# 这是并发准入估值，不替代 AGENT_TASK_BUDGET_USD / ORCH_TASK_BUDGET_USD 的执行限额。
# ORCH_BUDGET_RESERVATION_USD=0.05
# 仅个人单 Agent HTTP/UI 的理解沟通；Brain/Worker 与团队编排不启用。
# 用户主动申请，或独立项目分析发现有依据的严重偏差时触发。
# AGENT_UNDERSTANDING_ENABLED=1
# 每次独立出题、追问、偏差分析的 SDK 估算预算：
# AGENT_UNDERSTANDING_MAX_COST_USD=0.10
# 本项目沟通调用的累计预算；0 为不限制，与执行任务费用分开列账：
# AGENT_UNDERSTANDING_BUDGET_USD=0
# 问答、资料、费用保存于 <AGENT_WORK_DIR>/.understanding/<workspace-hash>/
# 原 budgets.json 首次导入后，邻接的 budgets.json.sqlite3 成为权威账本；旧 JSON 保留。
